# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (contêm segredos — NUNCA commitar)
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# build artifacts
*.apk
*.aab

# Firebase config (contêm chaves do projeto)
firebase/google-services.json
firebase/GoogleService-Info.plist
# Service account = SEGREDO de admin — pertence ao BACKEND, nunca ao app cliente
firebase/*adminsdk*.json
*-firebase-adminsdk-*.json

# Service account da Google Play (usada pelo `eas submit`)
credentials/
# Gerado por `eas credentials` > Download — contém as SENHAS da keystore
credentials.json

# Chave .p8 da App Store Connect API (usada pelo `eas submit` iOS)
secrets/
