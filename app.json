{
  "expo": {
    "name": "empregol-app",
    "slug": "empregol-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-empregol.png",
    "scheme": "empregolapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.empregolapp",
      "usesAppleSignIn": true,
      "googleServicesFile": "./firebase/GoogleService-Info.plist"
    },
    "android": {
      "package": "com.empregolapp",
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1F7A3D",
        "foregroundImage": "./assets/images/icon-empregol-fg.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141413",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
