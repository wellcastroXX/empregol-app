{
  "expo": {
    "name": "Empregol",
    "slug": "empregol-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-empregol.png",
    "scheme": "empregolapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.empregol",
      "usesAppleSignIn": true,
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.empregolapp",
      "googleServicesFile": "./firebase/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1F7A3D",
        "foregroundImage": "./assets/images/icon-empregol-fg.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141413",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Empregol usa suas fotos para você publicar mídias na sua vitrine.",
          "cameraPermission": "O Empregol usa a câmera para você gravar jogadas e fotos para a vitrine.",
          "microphonePermission": "O Empregol usa o microfone ao gravar vídeos das suas jogadas."
        }
      ],
      "./plugins/withExplicitModulesDisabled"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18fdc8a7-456d-4416-af04-4fd6c263293e"
      }
    },
    "owner": "wellcastrox"
  }
}
