{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ Empregol · Android (dev build)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx expo run:android",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "boot-emulator"
    },
    {
      "name": "▶ Empregol · Android (Metro, limpar cache)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx expo start --dev-client --clear",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "boot-emulator"
    },
    {
      "name": "▶ Empregol · Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx expo start --web",
      "cwd": "${workspaceFolder}"
    }
  ]
}
